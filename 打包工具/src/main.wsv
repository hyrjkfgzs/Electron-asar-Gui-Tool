<volprg type = "normal" version = 1 />

package 火山.程序 <@视窗.附属文件.debug = "ww > ww">

class 启动类 <public base_class = 程序类>
{
    var 集_类型 <type = 整数>
    var 集_计数 <type = 整数>
    var 集_执行 <type = 逻辑型>
    var 集_node版本 <type = 文本型>
    var 集_asar版本 <type = 文本型>
    var ""
    var 主窗口ID <type = 整数>
    var cmd <type = 匿名管道类_>
    var Jade <type = JadeView>
    var Jade托盘 <type = JadeView_托盘>
    var 应用包 <type = 字节集类 @视窗.值文件 = "app.japk">

    method 启动方法 <public type = 整数 collapsed>
    {
        如果真 (Jade.取WebView版本 () == "")
        {
            信息框_ ("当前系统未安装WebView请安装后再打开本程序!", 16, "错误信息", )
            结束 ()
        }
        Jade.订阅事件 (订阅_视图事件.请求新窗口)
        如果 (Jade.初始化 (是否为调试版 (), "", "", "Electron asar Gui工具", "HyJunYaa.ASAR.app", 真) == 假)
        {
            返回 (0)
        }
        Jade.置IPC频道回调 (本对象, "ipcChannelMessageCallback")  // IPC频道消息 此为非静态回调方式
        Jade.注册IPC通道 ("Titleevent")

        Jade.注册IPC通道 ("selectFolder")
        Jade.注册IPC通道 ("selectSavePath")
        Jade.注册IPC通道 ("pack")

        Jade.注册IPC通道 ("selectAsarFile")
        Jade.注册IPC通道 ("selectUnpackSavePath")
        Jade.注册IPC通道 ("unpack")

        Jade.运行消息循环 ()
        返回 (1)
    }

    method 函数_日志 <collapsed>
    param 窗口ID <type = 整数>
    param 日志内容 <type = 文本型>
    param 日志等级 <type = 文本型 explain = "info：默认文本颜色 success：绿色 error：红色" @默认值 = "info">
    {
        // Jade.发送IPC消息 (窗口ID, "log", "{\"message\":\"❌当前打包环境异常!\",\"type\":\"error\"}")
        Jade.发送IPC消息 (窗口ID, "log", "{\"message\":\"" + 日志内容 + "\",\"type\":\"" + 日志等级 + "\"}")
    }

    method IPC频道消息 <type = 文本型 explain = "供 置IPC频道回调 匹配对象方法签名使用。返回空文本表示不回传；返回非空文本时桥接层会自动调用 jade_text_create。" collapsed
            collapsed2 @强制输出 = 真 @输出名 = "ipcChannelMessageCallback">
    param 通道名 <type = 文本型>
    param 窗口ID <type = 整数>
    param 数据 <type = 文本型>
    {
        // 调试输出 (取源方法名 (), 通道名, 窗口ID, 数据)
        var json <type = JSON对象类>
        如果真 (取反 (json.创建自文本 (数据)))
        {
            返回 ("")
        }
        <collapsed> 如果真 (通道名 == "unpack")  // 解包
        {
            cmd.关闭命令_ ()
            cmd.初始化_ (10)
            var 局_解包路径 <type = 文本型>
            var 局_保存路径 <type = 文本型>
            局_解包路径 = json.取文本值 ("filePath")
            局_保存路径 = json.取文本值 ("savePath") + "/" + 文件_取文件名2 (局_解包路径) + "/"
            如果真 (集_asar版本 == "" || 集_node版本 == "")
            {
                函数_日志 (窗口ID, "❌  当前打包环境异常!", "error")
                返回 ("")
            }
            集_类型 = 1
            cmd.执行命令_ ("asar extract \"" + 局_解包路径 + "\" \"" + 局_保存路径 + "\"", 假)
        }
        <collapsed> 如果真 (通道名 == "selectUnpackSavePath")  // 选择解包后保存路径
        {
            var jj <type = 水淼JSON类>
            var 局_临时 <type = 文本型>
            var 局_目录 <type = 文本型>
            局_临时 = Jade.打开文件对话框 (窗口ID, "请选择解包后保存的路径", 取运行目录 (), "确定", , "openDirectory")
            如果真 (局_临时 == "")
            {
                函数_日志 (窗口ID, "❌  当前未选择文件夹!", "error")
                返回 ("")
            }
            jj.解析 (局_临时, , )
            如果 (jj.读逻辑值 ("canceled"))
            {
                函数_日志 (窗口ID, "❌  用户已取消!", "error")
                返回 ("")
            }
            否则
            {
                局_目录 = jj.读路径值 ("filePaths[0]", , , , , )
            }
            如果 (局_目录 != "")
            {
                Jade.发送IPC消息 (窗口ID, "selectUnpackSavePath", 局_目录)
            }
            否则
            {
                函数_日志 (窗口ID, "❌  当前未选择文件夹!", "error")
            }
        }
        如果真 (通道名 == "selectAsarFile")  // 选择解包文件
        {
            var jj <type = 水淼JSON类 edit_info = "0, 52823, 0, 0">
            var 局_临时 <type = 文本型 edit_info = "0, 52823, 0, 0">
            var 局_目录 <type = 文本型 edit_info = "0, 52823, 0, 0">
            var 局_过滤器 <type = 文本型
                    value = "[{\r\n    \"name\": \"打包后的文件\",\r\n    \"extensions\": [\"japk\",\"asar\"]\r\n}, {\r\n    \"name\": \"所有文件\",\r\n    \"extensions\": [\"*\"]\r\n}]"
                    edit_info = "0, 52823, 0, 0">
            局_临时 = Jade.打开文件对话框 (窗口ID, "请选择要解包的文件", 取特定目录 (特定目录类型.系统桌面), "确定", 局_过滤器, "openFile")
            // 调试输出 (局_临时)
            如果真 (局_临时 == "")
            {
                函数_日志 (窗口ID, "❌  当前未选择要解包的文件!", "error")
                返回 ("")
            }
            jj.解析 (局_临时, , )
            如果 (jj.读逻辑值 ("canceled"))
            {
                函数_日志 (窗口ID, "❌  用户已取消!", "error")
                返回 ("")
            }
            否则
            {
                局_目录 = jj.读路径值 ("filePaths[0]", , , , , )
            }
            如果 (局_目录 != "")
            {
                Jade.发送IPC消息 (窗口ID, "selectAsarFile", 局_目录)
            }
            否则
            {
                函数_日志 (窗口ID, "❌  当前未选择要解包的文件!", "error")
            }
        }
        <collapsed> 如果真 (通道名 == "pack")  // 打包
        {
            cmd.关闭命令_ ()
            cmd.初始化_ (10)
            var 局_打包路径 <type = 文本型>
            var 局_保存路径 <type = 文本型>
            局_打包路径 = json.取文本值 ("folderPath") + "/"
            局_保存路径 = json.取文本值 ("savePath") + "/"
            调试输出 (局_打包路径, 局_保存路径)
            如果真 (集_asar版本 == "" || 集_node版本 == "")
            {
                函数_日志 (窗口ID, "❌  当前打包环境异常!", "error")
                返回 ("")
            }
            集_类型 = 0
            cmd.执行命令_ ("asar pack \"" + 局_打包路径 + "\" " + 局_保存路径 + "\\app.japk", 假)
        }
        <collapsed> 如果真 (通道名 == "selectSavePath")  // 选择打包后保存路径
        {
            var jj <type = 水淼JSON类>
            var 局_临时 <type = 文本型>
            var 局_目录 <type = 文本型>
            局_临时 = Jade.打开文件对话框 (窗口ID, "请选择要保存到的文件夹", 取特定目录 (特定目录类型.系统桌面), "确定", , "openDirectory")
            如果真 (局_临时 == "")
            {
                函数_日志 (窗口ID, "❌  当前未选择文件夹!", "error")
                返回 ("")
            }
            jj.解析 (局_临时, , )
            如果 (jj.读逻辑值 ("canceled"))
            {
                函数_日志 (窗口ID, "❌  用户已取消!", "error")
                返回 ("")
            }
            否则
            {
                局_目录 = jj.读路径值 ("filePaths[0]", , , , , )
            }
            如果 (局_目录 != "")
            {
                Jade.发送IPC消息 (窗口ID, "selectSavePath", 局_目录)
            }
            否则
            {
                函数_日志 (窗口ID, "❌  当前未选择文件夹!", "error")
            }
        }
        <collapsed> 如果真 (通道名 == "selectFolder")  // 选择打包文件夹
        {
            var jj <type = 水淼JSON类>
            var 局_临时 <type = 文本型>
            var 局_目录 <type = 文本型>
            局_临时 = Jade.打开文件对话框 (窗口ID, "请选择要打包的文件夹", 取运行目录 (), "确定", , "openDirectory")
            如果真 (局_临时 == "")
            {
                函数_日志 (窗口ID, "❌  当前未选择文件夹!", "error")
                返回 ("")
            }
            jj.解析 (局_临时, , )
            如果 (jj.读逻辑值 ("canceled"))
            {
                函数_日志 (窗口ID, "❌  用户已取消!", "error")
                返回 ("")
            }
            否则
            {
                局_目录 = jj.读路径值 ("filePaths[0]", , , , , )
            }
            如果 (局_目录 != "")
            {
                Jade.发送IPC消息 (窗口ID, "selectFolder", 局_目录)
            }
            否则
            {
                函数_日志 (窗口ID, "❌  当前未选择文件夹!", "error")
            }
        }
        <collapsed> 如果真 (通道名 == "Titleevent")
        {
            var 类型 <type = 整数>
            类型 = json.取整数值 ("type")
            分支判断 (类型)
            {
                分支 (0)
                {
                    Jade.窗口关闭 (窗口ID)
                }
                分支 (1)
                {
                    Jade.窗口最小化 (窗口ID)
                }
                分支 (2)
                {
                    Jade.窗口最大化切换 (窗口ID)
                }

            }
        }
        返回 ("")
    }

    method JadeView_应用就绪 <receiver type = 整数 explain = "初始化阶段事件。默认会在 初始化() 内自动订阅。成功时数据通常为 success；失败时为错误文本或 JSON。返回值忽略。">
    param 来源对象 <type = JadeView explain = "提供事件产生的具体来源对象">
    param 标记值 <type = 整数 explain = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    param 窗口ID <type = 整数>
    param 数据 <type = 文本型>
    {
        如果 (来源对象 == Jade)
        {
            var 窗口选项 <type = JadeView_窗口选项>
            var 视图选项 <type = JadeView_视图选项>
            窗口选项.标题 = "Electron asar Gui工具"
            窗口选项.左边 = -1
            窗口选项.顶边 = -1
            窗口选项.宽度 = 840
            窗口选项.高度 = 620
            窗口选项.可调整大小 = 假
            窗口选项.初始隐藏 = 真
            窗口选项.透明窗口 = 真
            窗口选项.边框风格 = 窗口边框样式.无边框
            // 窗口选项.主题 = 窗口主题.浅色
            窗口选项.内容保护 = 假
            视图选项.允许全屏 = 真
            视图选项.后台节流 = 真
            视图选项.自动播放 = 真
            视图选项.PostMessage白名单 = ""
            var 本地资源地址 <type = 文本型>
            如果 (是否为调试版 ())
            {
                本地资源地址 = Jade.置协议服务目录 (取运行目录 () + "ww")
            }
            否则
            {
                如果真 (Jade.应用包_加载字节集 (应用包) != 0)
                {
                    Jade.消息框 (窗口ID, "错误信息:", "加载应用包失败!", "", "", 0, 0, 提示框类型.错误)
                    结束 ()
                }
                本地资源地址 = Jade.置协议服务目录 ("")
            }
            主窗口ID = Jade.创建窗口 (本地资源地址, 0, 窗口选项, 视图选项)
        }
        返回 (0)
    }

    method JadeView_全部窗口已关闭 <receiver type = 整数 explain = "全部窗口都关闭后触发。返回值忽略。" collapsed>
    param 来源对象 <type = JadeView explain = "提供事件产生的具体来源对象">
    param 标记值 <type = 整数 explain = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    param 窗口ID <type = 整数>
    {
        如果 (来源对象 == Jade)
        {
            cmd.终止命令_ ()
            cmd.关闭命令_ ()
            结束 ()
        }
        返回 (0)
    }

    method JadeView_加载完成 <receiver type = 整数 explain = "页面加载完成时触发。返回值忽略。" collapsed>
    param 来源对象 <type = JadeView explain = "提供事件产生的具体来源对象">
    param 标记值 <type = 整数 explain = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    param 窗口ID <type = 整数>
    param 地址 <type = 文本型>
    {
        如果 (来源对象 == Jade)
        {
            cmd.关闭命令_ ()
            cmd.初始化_ (200)
            Jade.发送IPC消息 (主窗口ID, "msg", "🌴正在检查打包环境...")
            函数_日志 (窗口ID, "🍄  欢迎使用Electron asar GUI打包工具", "success")
            函数_日志 (窗口ID, "🌴  By:回忆菌     Ver:1.0.2", "success")
            函数_日志 (窗口ID, "🍂  当前代码写的很粗糙,如果你遇见了BUG请联系作者修复!", "success")
            Jade.发送IPC消息 (主窗口ID, "selectSavePath", 取特定目录 (特定目录类型.系统桌面))
            Jade.发送IPC消息 (主窗口ID, "selectUnpackSavePath", 取特定目录 (特定目录类型.系统桌面))
            Jade.置窗口可见 (窗口ID, 真)
            集_计数 = 0
            集_执行 = 假
            多线程.启动线程 ()
            {
                延迟_ (1000)
                集_执行 = cmd.执行命令_ ("node --version", 假)
                多线程.结束当前线程 ()
            }
            多线程.启动失败 ()
            {
                Jade.消息框 (窗口ID, "错误信息:", "初始化失败!", "", "[\"确定\"]", 0, 0, 提示框类型.错误)
                结束 ()
            }
        }
        返回 (0)
    }

    method 匿名管道类__输出信息事件 <receiver type = 整数 explain = "启动命令行提示符或执行命令后,在此返回命令的输出信息" res_explain = "此返回值无意义" collapsed>
    param 来源对象 <type = 匿名管道类_ explain = "提供事件产生的具体来源对象">
    param 标记值 <type = 整数 explain = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    param 输出信息 <type = 字节集类 explain = "  命令行提示符打印在屏幕上的文本,请根据命令行的编码" explain = "使用\"多字节到文本\"或\"UTF8到文本\"等命令转换到文本型.">
    {
        如果 (来源对象 == cmd)
        {
            var 局_结果 <type = 文本数组类>
            分割文本 (多字节到文本 (输出信息), "\r\n", 局_结果, 真, 真)
            如果真 (局_结果.取成员数 () >= 2)
            {
                如果真 (集_计数 == 1)
                {
                    var 局_临时 <type = 文本型>
                    var 局_发送结果 <type = 文本型>
                    局_临时 = 局_结果.取成员 (0)
                    如果 (局_临时 == "asar --version")
                    {
                        集_asar版本 = 局_结果.取成员 (1)
                    }
                    否则
                    {
                        集_asar版本 = 局_临时
                    }
                    集_计数 = 集_计数 + 1
                    // 调试输出 (集_node版本, 集_asar版本)
                    局_发送结果 = 局_发送结果 + "🚀  当前环境丨"
                    如果 (寻找文本 (集_node版本, "不是内部或外部命令", , ) != -1)
                    {
                        局_发送结果 = 局_发送结果 + "node：未安装"
                        集_node版本 = ""
                    }
                    否则
                    {
                        局_发送结果 = 局_发送结果 + "node：" + 集_node版本
                    }
                    如果 (寻找文本 (集_asar版本, "不是内部或外部命令", , ) != -1)
                    {
                        局_发送结果 = 局_发送结果 + "      asar：未安装"
                        集_asar版本 = ""
                    }
                    否则
                    {
                        局_发送结果 = 局_发送结果 + "      asar：" + 集_asar版本
                    }
                    Jade.发送IPC消息 (主窗口ID, "msg", 局_发送结果)
                }
                如果真 (集_计数 == 0 && 集_执行)
                {
                    var 局_临时 <type = 文本型>
                    局_临时 = 局_结果.取成员 (0)
                    如果 (局_临时 == "node --version")
                    {
                        集_node版本 = 局_结果.取成员 (1)
                    }
                    否则
                    {
                        集_node版本 = 局_临时
                    }
                    集_计数 = 集_计数 + 1
                    cmd.执行命令_ ("asar --version", 假)
                }
            }
            如果真 (集_计数 > 1 && 集_执行)
            {
                集_计数 = 集_计数 + 1
            }
            如果真 (集_计数 == 5 && 集_类型 == 0)
            {
                函数_日志 (主窗口ID, "☘️  打包命令执行完成!请自行查看是否打包成功!", "success")
                集_计数 = 3
            }
            如果真 (集_计数 == 5 && 集_类型 == 1)
            {
                函数_日志 (主窗口ID, "☘️  解包命令执行完成!请自行查看是否解包成功!", "success")
                集_计数 = 3
            }
        }
        返回 (0)
    }
}
